# ---------------------------------------------------------------------------
# Leadloop - environment template
# Copy to `.env` and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local development (default): SQLite, zero setup.
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL). Run `npm run db:provider postgresql` before deploying.
# DATABASE_URL="postgresql://user:password@host:5432/lead_recovery?schema=public"

# --- Security --------------------------------------------------------------
# 32+ char random string used to sign session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Demo mode -------------------------------------------------------------
# When true, mock providers are used and demo credentials are shown on /login.
# MUST be false in production.
DEMO_MODE="true"

# --- AI provider (optional; mock provider used when unset) ------------------
AI_PROVIDER="mock"            # mock | openai
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- WhatsApp Business Platform (optional; mock used when unset) ------------
MESSAGING_PROVIDER="mock"     # mock | whatsapp_cloud
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# --- Meta Lead Ads (optional; mock used when unset) -------------------------
LEAD_SOURCE_PROVIDER="mock"   # mock | meta
META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""
META_VERIFY_TOKEN=""

# --- Scheduler / automation ------------------------------------------------
# Shared secret required by POST /api/cron/run (for n8n, Vercel Cron, etc.)
CRON_SECRET=""
